package() {
    install -Dm644 mkinitcpio.conf "$pkgdir/etc/mkinitcpio.conf.d/05-oblio.conf"
    install -Dm644 limine-entry-tool.conf "$pkgdir/etc/limine-entry-tool.d/oblio.conf"
    install -Dm644 oblio-wired.network "$pkgdir/usr/lib/systemd/network/89-oblio-wired.network"
    install -Dm644 oblio-wireless.network "$pkgdir/usr/lib/systemd/network/89-oblio-wireless.network"
    install -Dm644 snapper-template "$pkgdir/usr/share/snapper/config-templates/oblio"
    install -Dm755 oblio-snapshot oblio-desktop oblio-update -t "$pkgdir/usr/bin/"
    install -Dm644 resolved.conf "$pkgdir/usr/lib/systemd/resolved.conf.d/oblio.conf"
    install -Dm644 paccache.conf "$pkgdir/usr/lib/systemd/system/paccache.service.d/oblio.conf"
    install -Dm644 fish_prompt.fish fish_greeting.fish -t "$pkgdir/etc/fish/functions/"
    install -Dm644 editor.sh "$pkgdir/etc/profile.d/oblio-editor.sh"
    install -Dm644 editor.fish "$pkgdir/usr/share/fish/vendor_conf.d/oblio-editor.fish"
}
