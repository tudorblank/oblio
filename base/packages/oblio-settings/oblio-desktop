#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Installs (or updates) Oblio's desktop from the official repository:
#   oblio-desktop                 then reboot to get the login screen
#   oblio-desktop --greeter       also replace another login manager (SDDM, GDM, ...)
#   oblio-desktop --update [SHA]  no questions, the given commit or the newest (oblio-update)
#   oblio-desktop --latest        prints the newest commit (empty when GitHub can't be reached)
# OBLIO_SOURCE=<tarball url> installs from somewhere else (tests).

set -euo pipefail

repo=tudorblank/oblio
red=$'\e[1;31m' bold=$'\e[1m' off=$'\e[0m'

latest() {
    curl -fsS --max-time 15 -H 'Accept: application/vnd.github.sha' \
        "https://api.github.com/repos/$repo/commits/main" 2>/dev/null | grep -xE '[0-9a-f]{40}' || true
}

update=0 commit="" args=()
while (( $# )); do
    case $1 in
        --greeter) args+=(--greeter) ;;
        --latest) latest; exit 0 ;;
        --update)
            update=1
            if [[ ${2:-} =~ ^[0-9a-f]{40}$ ]]; then commit=$2; shift; fi
            ;;
        *) echo "usage: oblio-desktop [--greeter] [--update [COMMIT]] | --latest" >&2; exit 1 ;;
    esac
    shift
done
[[ $EUID != 0 ]] || { echo "error: run as your normal user, not root" >&2; exit 1; }

# desktop sessions already installed (the ones a login screen would offer)
sessions() {
    local f exe
    for f in /usr/share/wayland-sessions/*.desktop /usr/share/xsessions/*.desktop; do
        [[ -e $f ]] || continue
        grep -qE '^(Hidden|NoDisplay)=true' "$f" && continue
        exe="$(sed -n 's/^TryExec=//p' "$f" | head -n1)"
        [[ -n $exe ]] || exe="$(sed -n 's/^Exec=//p' "$f" | head -n1 | cut -d' ' -f1)"
        command -v "$exe" >/dev/null 2>&1 || continue
        sed -n 's/^Name=//p' "$f" | head -n1
    done | sort -u | paste -sd, - | sed 's/,/, /g'
}

if ! curl -fsI --max-time 10 "https://github.com" >/dev/null 2>&1; then
    wifi=wlan0
    for d in /sys/class/net/*; do
        if [[ -e $d/phy80211 ]]; then wifi="${d##*/}"; break; fi
    done
    echo "${red}No internet connection.${off} oblio-desktop downloads the desktop from GitHub."
    echo "Plug in a network cable, or connect to Wi-Fi (it's remembered after that):"
    echo
    echo "  sudo iwctl station $wifi scan"
    echo "  sudo iwctl station $wifi get-networks"
    echo "  sudo iwctl station $wifi connect \"Network name\""
    echo
    echo "Then run oblio-desktop again."
    exit 1
fi

# the exact commit, so the installed desktop knows its version (oblio-update compares it)
if [[ -z $commit && -z ${OBLIO_SOURCE:-} ]]; then
    commit="$(latest)"
fi
if [[ -n ${OBLIO_SOURCE:-} ]]; then
    source=$OBLIO_SOURCE
elif [[ -n $commit ]]; then
    source="https://github.com/$repo/archive/$commit.tar.gz"
else
    source="https://github.com/$repo/archive/refs/heads/main.tar.gz"
fi

if (( ! update )); then
    current="$(sessions)"
    echo
    echo "${red}WARNING!${off} This installs the latest Oblio desktop on this Oblio system."
    echo "It's best installed on a fresh Oblio setup."
    echo "Desktop sessions you have now: ${bold}${current:-none}${off}"
    echo
    read -rp "Proceed? [Y/n] " answer
    [[ -z $answer || $answer == [yY]* ]] || { echo "Nothing was changed."; exit 0; }
fi

dir="$(mktemp -d)"
trap 'rm -rf "$dir"' EXIT
echo "Downloading Oblio's desktop..."
if ! curl -fL --progress-bar -o "$dir/oblio.tar.gz" "$source"; then
    echo "${red}error:${off} the download failed, nothing was changed. Check the connection and try again." >&2
    exit 1
fi
tar xzf "$dir/oblio.tar.gz" -C "$dir" --strip-components=1
OBLIO_COMMIT="$commit" "$dir/desktop/setup" "${args[@]}"
