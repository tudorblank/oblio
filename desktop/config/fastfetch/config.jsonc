// Oblio's fastfetch: the logo is oblio.txt, the spiky ball (assets) filled in ASCII
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/oblio.txt",
        "color": { "1": "green" },
        "padding": { "top": 0, "left": 0, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "green", "title": "green" }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        { "type": "gpu", "format": "{name}" },
        "memory",
        "disk",
        { "type": "battery", "key": "Battery" },
        "break",
        "colors"
    ]
}
