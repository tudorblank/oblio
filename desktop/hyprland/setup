#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Oblio's Hyprland desktop for an installed Oblio: Hyprland, Oblio's window
# management (minimize, show desktop, tiling/floating per workspace), the Oblio
# dock, Alacritty, Dolphin. Run as your normal user; pacman runs through sudo.
#   desktop/hyprland/setup

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
shell_src="$here/../shell"
shell_dir="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/oblio"

packages=(
    quickshell                   # runs the Oblio shell (dock)
    hyprland                     # compositor (pulls in XWayland)
    hyprlauncher                 # app launcher, SUPER+R
    hyprpolkitagent              # password prompts for admin actions
    xdg-desktop-portal-hyprland  # screen sharing, portals
    qt6-wayland                  # Qt apps (Dolphin) run natively on Wayland
    alacritty                    # terminal, SUPER+Q
    dolphin                      # file manager, SUPER+E
    breeze-icons                 # icons for Dolphin
    archlinux-xdg-menu           # Dolphin's "Open with" menus outside Plasma
    ttf-dejavu                   # a font, the base system has none
)

config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua"
default="${OBLIO_HYPR_DEFAULT:-/usr/share/hypr/hyprland.lua}"
red=$'\e[1;31m' bold=$'\e[1m' off=$'\e[0m'

msg() { printf '%s==>%s %s%s%s\n' "$red" "$off" "$bold" "$*" "$off"; }
die() { printf '%serror:%s %s\n' "$red" "$off" "$*" >&2; exit 1; }

[[ $EUID != 0 ]] || die "run as your normal user, not root"

msg "Installing packages"
sudo pacman -S --needed --noconfirm "${packages[@]}"

msg "Writing $config"
if [[ -e $config ]]; then
    cp "$config" "$config.bak.$(date +%Y%m%d-%H%M%S)"
    echo "existing config backed up"
fi
mkdir -p "${config%/*}"

# console keymap -> keyboard layout, when it is also a valid XKB layout
layout=us
keymap="$(sed -n 's/^KEYMAP=//p' /etc/vconsole.conf 2>/dev/null)"
if [[ -n $keymap ]] && localectl list-x11-keymap-layouts | grep -qx "$keymap"; then
    layout="$keymap"
fi

# In a VM the host desktop keeps Super for itself (KDE, GNOME, Windows), so the
# VM gets Alt as its main key. On real hardware it stays Super.
mod=SUPER
if systemd-detect-virt -q; then mod=ALT; fi

# start from Hyprland's own default config, then adjust it
sed -e 's/^local terminal    = "kitty"$/local terminal    = "alacritty"/' \
    -e "s/^\(        kb_layout  = \)\"us\",$/\1\"$layout\",/" \
    -e "s/^local mainMod = \"SUPER\"/local mainMod = \"$mod\"/" \
    "$default" > "$config"

{
    cat <<'EOF'


---------------
---- OBLIO ----
---------------

-- minimize, show desktop, tiling/floating per workspace (oblio.lua)
require("oblio").setup({ mod = mainMod })

-- Dolphin's "Open with" menus outside Plasma
hl.env("XDG_MENU_PREFIX", "arch-")

hl.on("hyprland.start", function()
    hl.exec_cmd("/usr/lib/hyprpolkitagent/hyprpolkitagent")
    hl.exec_cmd("qs -c oblio")
end)

-- the dock gets the blurred-glass look
hl.layer_rule({ match = { namespace = "oblio-dock" }, blur = true, ignore_alpha = 0.3 })

hl.config({
    ecosystem = {
        no_update_news = true,
        no_donation_nag = true,
    },
})
EOF

    if lspci -k 2>/dev/null | grep -q "Kernel driver in use: nvidia"; then
        cat <<'EOF'

-- Nvidia: video decoding and OpenGL go through Nvidia's driver
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
hl.env("NVD_BACKEND", "direct")
EOF
    fi

    if systemd-detect-virt -q; then
        cat <<'EOF'

-- virtual machine: the virtual GPU has no hardware cursor
hl.config({
    cursor = {
        no_hardware_cursors = true,
    },
})
EOF
    fi
} >> "$config"

msg "Installing Oblio's window management and shell"
install -Dm644 "$here/oblio.lua" "${config%/*}/oblio.lua"
mkdir -p "$shell_dir"
install -m644 "$shell_src"/*.qml "$shell_dir/"

msg "Building Dolphin's application menu"
XDG_MENU_PREFIX=arch- kbuildsycoca6 --noincremental >/dev/null 2>&1 || true

msg "Done"
cat <<EOF

Start Hyprland from the console with:  ${bold}start-hyprland${off}

  $mod + Q       terminal (Alacritty)
  $mod + E       files (Dolphin)
  $mod + R       app launcher
  $mod + C       close window
  $mod + H       minimize window          $mod + SHIFT + H   restore last minimized
  $mod + D       show desktop (minimize all, again to restore)
  $mod + T       this workspace: tiling <-> floating
  $mod + 1..0    switch workspace
  $mod + M       exit Hyprland

Dock: click = open / focus / restore, click the focused app = minimize,
      right click = minimize or restore all its windows, middle click = new window

Config: $config
EOF
if [[ $mod == ALT ]]; then
    echo "This is a virtual machine, so the main key is Alt instead of Super."
fi
