#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Oblio's desktop on any Arch-based system: Hyprland, Oblio's window management,
# keybinds, shell (bar, dock, settings, notifications) and login screen, Alacritty, Files,
# Zen, rofi. Run as your normal user; pacman and the system files go through sudo.
#   desktop/setup            install packages, copy desktop/config/ into ~/.config and
#                            desktop/oblio-shell/ to ~/.config/oblio-shell
#   desktop/setup --greeter  make Oblio's login screen the login manager even when
#                            another one (SDDM, GDM, ...) is already set up
#
# Every file in desktop/config/ lands at the same path under ~/.config; one you edited since
# the last install is kept as NAME.bak.DATE first. Your own changes from the settings panel
# (SUPER+I) live in ~/.config/hypr/settings.lua, which setup never touches.

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
stamp="$(date +%Y%m%d-%H%M%S)"
red=$'\e[1;31m' bold=$'\e[1m' off=$'\e[0m'

msg() { printf '%s==>%s %s%s%s\n' "$red" "$off" "$bold" "$*" "$off"; }
die() { printf '%serror:%s %s\n' "$red" "$off" "$*" >&2; exit 1; }

greeter=0
for arg; do
    case $arg in
        --greeter) greeter=1 ;;
        *) die "unknown option: $arg" ;;
    esac
done

[[ $EUID != 0 ]] || die "run as your normal user, not root"

packages=(
    hyprland                     # compositor (pulls in XWayland)
    quickshell                   # runs Oblio's shell (dock, settings) and login screen
    greetd                       # runs the login screen, then your session
    rofi                         # app launcher (SUPER+R)
    hyprpolkitagent              # password prompts for admin actions
    xdg-desktop-portal-hyprland  # screen sharing, portals
    xdg-desktop-portal-gtk       # file pickers (Open/Save dialogs) for portal apps
    qt6-wayland                  # Qt apps run natively on Wayland
    qt6-imageformats             # WebP and TIFF wallpapers
    alacritty                    # terminal
    fastfetch                    # system info with Oblio's logo (fastfetch in a terminal)
    xdg-utils                    # xdg-open: apps open links and files in the right program
    fuse2                        # AppImages
    nautilus                     # file manager (GNOME Files; extracts and compresses by itself)
    ffmpegthumbnailer            # video thumbnails in Files
    gvfs                         # trash, phones, network shares in Files and file pickers
    adw-gtk-theme                # GTK 3 apps in the same style as GTK 4 ones
    papirus-icon-theme           # icons for apps and the dock (Papirus-Dark / -Light)
    breeze-icons                 # icons for the login screen
    ttf-jetbrains-mono           # monospace font
    grim slurp wl-clipboard      # screenshots
    hyprpicker                   # color picker
    brightnessctl playerctl      # brightness and media keys
    upower                       # battery in the bar
    ffmpeg                       # H.264/AAC video in the browser (Zen loads it at runtime)
    xorg-xhost                   # lets admin apps (GParted, ...) open windows
    capitaine-cursors            # mouse cursor
    ttf-dejavu                   # a font, the base system has none
    inter-font                   # the login screen's font, and the fallback UI font
    ttf-nerd-fonts-symbols       # icons in the shell
)
# browser: Zen comes from the CachyOS repos (not on other systems)
for p in zen-browser-bin; do
    if pacman -Si "$p" &>/dev/null; then packages+=("$p"); fi
done

mapfile -t missing < <(pacman -T "${packages[@]}" || true)
if (( ${#missing[@]} )); then
    msg "Installing packages"
    # with a full sync: an install made days ago has package lists that point at removed files
    sudo pacman -Syu --needed --noconfirm "${missing[@]}"
fi

# checksums of the config files setup installed last time, to tell your edits from
# Oblio's own older versions
manifest="${XDG_STATE_HOME:-$HOME/.local/state}/oblio-desktop/installed.sha256"
declare -A installed=()
if [[ -f $manifest ]]; then
    while read -r sum path; do installed[$path]=$sum; done < "$manifest"
fi

# copies SRC to DST. An identical DST is left alone (no needless Hyprland reload); a file you
# changed since setup installed it is kept as DST.bak.DATE
place() {
    local src="$1" dst="$2"
    mkdir -p "${dst%/*}"
    if [[ -e $dst && ! -L $dst ]]; then
        diff -rq "$src" "$dst" >/dev/null 2>&1 && return
        if [[ -f $dst && $(sha256sum < "$dst" | cut -d' ' -f1) != "${installed[$dst]:-}" ]]; then
            cp -a "$dst" "$dst.bak.$stamp"
        fi
    fi
    # written next to it, then renamed over it: Hyprland reloads on every change and must
    # never see the file missing or half written
    if [[ -d $src ]]; then
        rm -rf "$dst.new"
        cp -r "$src" "$dst.new"
        rm -rf "$dst"
        mv "$dst.new" "$dst"
    else
        install -m644 "$src" "$dst.new"
        mv -f "$dst.new" "$dst"
    fi
}

msg "Copying Oblio's desktop files into $cfg"
# the shell goes as a whole folder, so files removed from it don't linger (it's Oblio's
# program, not your config: replaced, never backed up)
place "$here/oblio-shell" "$cfg/oblio-shell"
while IFS= read -r -d '' src; do
    place "$src" "$cfg/${src#"$here/config/"}"
done < <(find "$here/config" -type f -print0)
mkdir -p "${manifest%/*}"
while IFS= read -r -d '' src; do
    dst="$cfg/${src#"$here/config/"}"
    printf '%s %s\n' "$(sha256sum < "$dst" | cut -d' ' -f1)" "$dst"
done < <(find "$here/config" -type f -print0) > "$manifest"

# UI font: SF Pro, Apple's, which may not be redistributed, so it isn't in this repository and
# comes from a pinned copy of github.com/sahibjotsaggu/San-Francisco-Pro-Fonts, checked against
# known checksums. Without it the desktop uses Inter. (Light/dark, accent and fonts are applied
# by the shell: Settings > Appearance.)
# downloads URL to DEST only when it matches SHA256 (nothing is left behind otherwise)
fetch() {
    local url=$1 sum=$2 dest=$3
    if curl -fsSL --max-time 300 -o "$dest.part" "$url" \
        && [[ $(sha256sum "$dest.part" | cut -d' ' -f1) == "$sum" ]]; then
        mv "$dest.part" "$dest"
    else
        rm -f "$dest.part"
        return 1
    fi
}

sf_commit=8bfea09aa6f1139479f80358b2e1e5c6dc991a58
fonts="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/SF Pro"
declare -A sf_sums=(
    [SF-Pro.ttf]=216c8f70fc35fb8161d03a7f8ddf5fff5760e1879688d70eb20ed9779b8ffee2
    [SF-Pro-Italic.ttf]=9eb0a0761f0f7df966159e091e7b7b905c422ca4b521e330280dc7c4c70f0567
)
for f in "${!sf_sums[@]}"; do
    [[ $(sha256sum "$fonts/$f" 2>/dev/null | cut -d' ' -f1) == "${sf_sums[$f]}" ]] && continue
    mkdir -p "$fonts"
    fetch "https://raw.githubusercontent.com/sahibjotsaggu/San-Francisco-Pro-Fonts/$sf_commit/$f" \
        "${sf_sums[$f]}" "$fonts/$f" \
        || printf 'warning: could not download %s, the desktop uses Inter instead\n' "$f" >&2
done
fc-cache -f "$fonts" >/dev/null 2>&1 || true

# icons: WhiteSur (github.com/vinceliuice/WhiteSur-icon-theme, GPL-3.0), a pinned copy checked
# against a known checksum and put together by copying its files (its own install script isn't
# run). WhiteSur-dark is the same set with light symbolic and small icons, sharing the rest
# through hard links. Without it the desktop uses Papirus.
ws_commit=73d8040da51a9ed74e47c7366e7e9ff437601a5c
ws_sum=96661649071d8a9664b40d42abea75286175234473106156e9a4b25f54e6cb0c
icons="${XDG_DATA_HOME:-$HOME/.local/share}/icons"
if [[ $(cat "$icons/WhiteSur/.oblio-version" 2>/dev/null) != "$ws_commit" ]]; then
    # built next to its final place: moving it there is a rename that keeps the hard links
    mkdir -p "$icons"
    ws_tmp="$(mktemp -d "$icons/.whitesur.XXXXXX")"
    if fetch "https://codeload.github.com/vinceliuice/WhiteSur-icon-theme/tar.gz/$ws_commit" \
        "$ws_sum" "$ws_tmp/ws.tar.gz"; then
        mkdir -p "$ws_tmp/src"
        tar -xzf "$ws_tmp/ws.tar.gz" -C "$ws_tmp/src" --strip-components=1
        w="$ws_tmp/src" t="$ws_tmp/WhiteSur"
        mkdir -p "$t/status"
        cp "$w/src/index.theme" "$t/"
        cp -r "$w"/src/{actions,animations,apps,categories,devices,emotes,emblems,mimes,places,preferences} "$t/"
        cp -r "$w"/src/status/{16,22,24,32,symbolic} "$t/status/"
        rm -f "$t"/places/scalable/user-trash{,-full}-dark.svg
        cp -r "$w"/links/{actions,apps,categories,devices,emotes,emblems,mimes,places,status,preferences} "$t/"
        cp -al "$t" "$ws_tmp/WhiteSur-dark"
        d="$ws_tmp/WhiteSur-dark"
        sed -i 's/^Name=.*/Name=WhiteSur-dark/' "$d/index.theme"
        rm -f "$d"/places/scalable/user-trash{,-full}.svg
        cp "$w/src/places/scalable/user-trash-dark.svg" "$d/places/scalable/user-trash.svg"
        cp "$w/src/places/scalable/user-trash-full-dark.svg" "$d/places/scalable/user-trash-full.svg"
        # sed -i writes new files, so only the recolored icons stop being shared
        find "$d" -type f -name '*.svg' \( -path '*/16/*' -o -path '*/22/*' -o -path '*/24/*' \
            -o -path '*/32/*' -o -path '*/symbolic/*' \) -exec sed -i 's/#363636/#dedede/g' {} +
        echo "$ws_commit" > "$t/.oblio-version"
        for v in WhiteSur WhiteSur-dark; do
            rm -rf "${icons:?}/$v"
            mv "$ws_tmp/$v" "$icons/$v"
            gtk-update-icon-cache -qf "$icons/$v" 2>/dev/null || true
        done
    else
        printf 'warning: could not download the WhiteSur icons, the desktop uses Papirus instead\n' >&2
    fi
    rm -rf "${ws_tmp:?}"
fi

# Files (Nautilus) gets WhiteSur's blue folder (org.xfce.filemanager, the icon the dock showed for
# Thunar), not its Finder face
for v in WhiteSur WhiteSur-dark; do
    a="$icons/$v/apps/scalable" f=../../preferences/32/org.xfce.filemanager.svg
    [[ -e $a/$f ]] || continue
    if [[ $(readlink "$a/org.gnome.Nautilus.svg") != "$f" ]]; then
        ln -sfn "$f" "$a/org.gnome.Nautilus.svg"
        ln -sfn "$f" "$a/org.gnome.nautilus.svg"
        gtk-update-icon-cache -qf "$icons/$v" 2>/dev/null || true
    fi
done
msg "Installing the login screen"
sudo install -Dm644 -t /usr/share/oblio/greeter "$here"/greeter/*.qml
sudo install -Dm644 "$here/greeter/hyprland.lua" /etc/greetd/oblio-hyprland.lua
sudo install -d -o greeter -g greeter -m755 /var/lib/oblio-greeter
# your lock screen wallpaper and look, copied there by the shell (the greeter can't read your home)
sudo install -d -m755 /var/lib/oblio-greeter/users
sudo install -d -o "$USER" -g "$(id -gn)" -m755 "/var/lib/oblio-greeter/users/$USER"
if ! grep -q oblio-hyprland /etc/greetd/config.toml 2>/dev/null; then
    [[ -e /etc/greetd/config.toml ]] && sudo cp /etc/greetd/config.toml "/etc/greetd/config.toml.bak.$stamp"
    sudo install -Dm644 /dev/stdin /etc/greetd/config.toml <<'EOF'
[terminal]
vt = 1

[default_session]
command = "start-hyprland -- --config /etc/greetd/oblio-hyprland.lua"
user = "greeter"
EOF
fi

# login managers own display-manager.service; don't take it from another one unless asked
dm="$(readlink /etc/systemd/system/display-manager.service 2>/dev/null || true)"
dm="${dm##*/}"
if [[ -z $dm || $dm == greetd.service ]]; then
    sudo systemctl enable greetd.service >/dev/null 2>&1
    login=greetd
elif ((greeter)); then
    sudo systemctl disable "$dm" >/dev/null 2>&1
    sudo systemctl enable greetd.service >/dev/null 2>&1
    login=greetd
else
    login="$dm"
fi

# the desktop portal finds its backends only when it starts: one started before
# xdg-desktop-portal-gtk was installed never tells apps about light/dark
if systemctl --user -q is-active xdg-desktop-portal.service 2>/dev/null \
    && ! busctl --user introspect org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop 2>/dev/null \
        | grep -q org.freedesktop.portal.Settings; then
    systemctl --user restart xdg-desktop-portal.service || true
fi

# inside a running Hyprland: swap the running shell for the new one (last, so it sees the fonts)
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null; then
    pkill -u "$USER" -f "^qs -p '?$cfg/oblio-shell'?$" || true
    # oblio.qs (env.lua): the one place that says how the shell starts
    hyprctl dispatch 'function() hl.exec_cmd(oblio.qs) end' >/dev/null 2>&1 || true
fi

# which version of the desktop this is, for oblio-update: the commit oblio-desktop downloaded,
# or this clone's (marked when the desktop has uncommitted changes)
version="${OBLIO_COMMIT:-}"
if [[ -z $version ]] && git -C "$here" rev-parse HEAD >/dev/null 2>&1; then
    version="$(git -C "$here" rev-parse HEAD)"
    [[ -z $(git -C "$here" status --porcelain -- . 2>/dev/null) ]] || version+="-modified"
fi
state="${XDG_STATE_HOME:-$HOME/.local/state}/oblio-desktop"
mkdir -p "$state"
echo "${version:-unknown}" > "$state/version"

msg "Done"
if [[ $login == greetd ]]; then
    echo "Reboot to get Oblio's login screen. Pick the session at the bottom left."
else
    echo "Your login manager stays ${login%.service}; it lists Hyprland as a session."
    echo "Run desktop/setup --greeter to switch to Oblio's login screen."
fi
