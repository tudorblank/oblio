#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Oblio's desktop on any Arch-based system: Hyprland, Oblio's window management,
# keybinds, dock and login screen, Alacritty, Dolphin, Zen. Run as your normal
# user; pacman and the system files go through sudo.
#   desktop/setup            install packages, copy desktop/config/ into ~/.config and
#                            desktop/oblio-shell/ (dock, settings) to ~/.config/oblio-shell
#   desktop/setup --greeter  make Oblio's login screen the login manager even when
#                            another one (SDDM, GDM, ...) is already set up
#
# Every file in desktop/config/ lands at the same path under ~/.config; a file it
# replaces is kept as NAME.bak.DATE. Your own changes from the settings panel
# (SUPER+I) live in ~/.config/hypr/settings.lua, which setup never touches.

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
stamp="$(date +%Y%m%d-%H%M%S)"
red=$'\e[1;31m' bold=$'\e[1m' off=$'\e[0m'

msg() { printf '%s==>%s %s%s%s\n' "$red" "$off" "$bold" "$*" "$off"; }
die() { printf '%serror:%s %s\n' "$red" "$off" "$*" >&2; exit 1; }

greeter=0
for arg; do
    case $arg in
        --greeter) greeter=1 ;;
        *) die "unknown option: $arg" ;;
    esac
done

[[ $EUID != 0 ]] || die "run as your normal user, not root"

packages=(
    hyprland                     # compositor (pulls in XWayland)
    quickshell                   # runs Oblio's shell (dock, settings) and login screen
    greetd                       # runs the login screen, then your session
    hyprlauncher                 # app launcher
    hyprpolkitagent              # password prompts for admin actions
    xdg-desktop-portal-hyprland  # screen sharing, portals
    qt6-wayland                  # Qt apps (Dolphin) run natively on Wayland
    alacritty                    # terminal
    xdg-utils                    # xdg-open: apps open links and files in the right program
    fuse2                        # AppImages
    dolphin                      # file manager
    archlinux-xdg-menu           # Dolphin's "Open with" menus outside Plasma
    breeze-icons                 # icons for Dolphin and the dock
    grim slurp wl-clipboard      # screenshots
    hyprpicker                   # color picker
    brightnessctl playerctl      # brightness and media keys
    xorg-xhost                   # lets admin apps (GParted, ...) open windows
    capitaine-cursors            # mouse cursor
    ttf-dejavu                   # a font, the base system has none
    inter-font                   # the login screen's font
    ttf-nerd-fonts-symbols       # icons in the shell
)
# browser: Zen comes from the CachyOS repos
if pacman -Si zen-browser-bin &>/dev/null; then packages+=(zen-browser-bin); fi

mapfile -t missing < <(pacman -T "${packages[@]}" || true)
if (( ${#missing[@]} )); then
    msg "Installing packages"
    sudo pacman -S --needed --noconfirm "${missing[@]}"
fi

# copies SRC to DST; an existing different file is kept as DST.bak.DATE, an identical
# one is left alone (no needless Hyprland reload)
place() {
    local src="$1" dst="$2"
    mkdir -p "${dst%/*}"
    if [[ -e $dst && ! -L $dst ]]; then
        diff -rq "$src" "$dst" >/dev/null 2>&1 && return
        mv "$dst" "$dst.bak.$stamp"
    fi
    # written next to it, then renamed over it: Hyprland reloads on every change and must
    # never see the file missing or half written
    if [[ -d $src ]]; then
        rm -rf "$dst.new"
        cp -r "$src" "$dst.new"
        rm -rf "$dst"
        mv "$dst.new" "$dst"
    else
        install -m644 "$src" "$dst.new"
        mv -f "$dst.new" "$dst"
    fi
}

msg "Copying Oblio's desktop files into $cfg"
# the shell goes as a whole folder, so files removed from it don't linger
place "$here/oblio-shell" "$cfg/oblio-shell"
while IFS= read -r -d '' src; do
    place "$src" "$cfg/${src#"$here/config/"}"
done < <(find "$here/config" -type f -print0)

# older versions kept the shell in ~/.config/quickshell/oblio, its settings under an id
# made from that path; the shell's id is "oblio" now
old="$cfg/quickshell/oblio"
state="${XDG_STATE_HOME:-$HOME/.local/state}/quickshell/by-shell"
old_id="$(printf '%s' "$old/shell.qml" | md5sum | cut -d' ' -f1)"
if [[ -f $state/$old_id/settings.json && ! -e $state/oblio/settings.json ]]; then
    mkdir -p "$state/oblio"
    cp "$state/$old_id/settings.json" "$state/oblio/settings.json"
fi
if [[ -e $old || -L $old ]]; then
    rm -rf "$old"
    rmdir "$cfg/quickshell" 2>/dev/null || true
fi

# inside a running Hyprland: swap the running shell for the new one
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null; then
    pkill -u "$USER" -f "^qs (-c oblio|-p '?$cfg/oblio-shell'?)$" || true
    hyprctl dispatch "hl.dsp.exec_cmd(\"qs -p '$cfg/oblio-shell'\")" >/dev/null 2>&1 || true
fi

msg "Building Dolphin's application menu"
# capped: it waits for any running KDE app holding the menu cache lock
XDG_MENU_PREFIX=arch- timeout 30 kbuildsycoca6 --noincremental >/dev/null 2>&1 || true

msg "Installing the login screen"
sudo install -Dm644 -t /usr/share/oblio/greeter "$here"/greeter/*.qml
sudo install -Dm644 "$here/greeter/hyprland.lua" /etc/greetd/oblio-hyprland.lua
sudo install -d -o greeter -g greeter -m755 /var/lib/oblio-greeter
if ! grep -q oblio-hyprland /etc/greetd/config.toml 2>/dev/null; then
    [[ -e /etc/greetd/config.toml ]] && sudo cp /etc/greetd/config.toml "/etc/greetd/config.toml.bak.$stamp"
    sudo install -Dm644 /dev/stdin /etc/greetd/config.toml <<'EOF'
[terminal]
vt = 1

[default_session]
command = "start-hyprland -- --config /etc/greetd/oblio-hyprland.lua"
user = "greeter"
EOF
fi

# login managers own display-manager.service; don't take it from another one unless asked
dm="$(readlink /etc/systemd/system/display-manager.service 2>/dev/null || true)"
dm="${dm##*/}"
if [[ -z $dm || $dm == greetd.service ]]; then
    sudo systemctl enable greetd.service >/dev/null 2>&1
    login=greetd
elif ((greeter)); then
    sudo systemctl disable "$dm" >/dev/null 2>&1
    sudo systemctl enable greetd.service >/dev/null 2>&1
    login=greetd
else
    login="$dm"
fi

msg "Done"
if [[ $login == greetd ]]; then
    echo "Reboot to get Oblio's login screen. Pick the session at the bottom left."
else
    echo "Your login manager stays ${login%.service}; it lists Hyprland as a session."
    echo "Run desktop/setup --greeter to switch to Oblio's login screen."
fi
