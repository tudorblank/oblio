#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

root="${OBLIO_ROOT:-}"
share="$root/usr/share/oblio"

case "${1:-}" in
    os-release)
        rm -f "$root/etc/os-release"
        install -Dm644 "$share/os-release" "$root/etc/os-release"
        ;;
    lsb-release)
        # owned by the lsb-release package, never create it
        [[ -e $root/etc/lsb-release ]] || exit 0
        install -m644 "$share/lsb-release" "$root/etc/lsb-release"
        ;;
    unbrand)
        rm -f "$root/etc/os-release"
        ;;
    *)
        echo "usage: ${0##*/} os-release|lsb-release|unbrand" >&2
        exit 1
        ;;
esac
