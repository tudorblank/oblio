#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# usage: oblio-vm iso       download and verify the latest Arch ISO
#        oblio-vm install   boot the Arch ISO, with the VM disk attached
#        oblio-vm run       boot the installed system
#        oblio-vm reset     delete the VM disk and UEFI variables

set -euo pipefail

dir="${OBLIO_VM_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/oblio-vm}"
disk="$dir/oblio.qcow2"
vars="$dir/OVMF_VARS.4m.fd"
iso="$dir/archlinux-x86_64.iso"
ovmf=/usr/share/edk2/x64
mirror=https://geo.mirror.pkgbuild.com/iso/latest

size="${OBLIO_VM_SIZE:-40G}"
mem="${OBLIO_VM_MEM:-4G}"
cpus="${OBLIO_VM_CPUS:-4}"

die() { echo "error: $*" >&2; exit 1; }

need_qemu() {
    command -v qemu-system-x86_64 >/dev/null && [[ -f $ovmf/OVMF_CODE.4m.fd ]] ||
        die "install QEMU first: sudo pacman -S qemu-desktop edk2-ovmf"
}

get_iso() {
    mkdir -p "$dir"
    curl -fL --progress-bar -o "$iso.part" "$mirror/archlinux-x86_64.iso"
    curl -fsSL -o "$iso.sig" "$mirror/archlinux-x86_64.iso.sig"
    curl -fsSL -o "$dir/sha256sums.txt" "$mirror/sha256sums.txt"

    local expected actual
    expected="$(awk '$2 == "archlinux-x86_64.iso" {print $1}' "$dir/sha256sums.txt")"
    actual="$(sha256sum "$iso.part" | cut -d' ' -f1)"
    [[ -n $expected && $expected == "$actual" ]] || die "checksum mismatch"

    # separate keyring so your own GnuPG setup is left alone
    export GNUPGHOME="$dir/gnupg"
    mkdir -p -m 700 "$GNUPGHOME"
    gpg --quiet --auto-key-locate clear,wkd --keyserver-options auto-key-retrieve \
        --verify "$iso.sig" "$iso.part" || die "signature check failed"

    mv "$iso.part" "$iso"
    echo "verified: $iso"
}

boot() {
    need_qemu
    mkdir -p "$dir"
    [[ -f $disk ]] || qemu-img create -f qcow2 "$disk" "$size" >/dev/null
    [[ -f $vars ]] || install -m644 "$ovmf/OVMF_VARS.4m.fd" "$vars"

    local -a cmd=(
        qemu-system-x86_64 -enable-kvm -machine q35 -cpu host -smp "$cpus" -m "$mem"
        -drive "if=pflash,format=raw,readonly=on,file=$ovmf/OVMF_CODE.4m.fd"
        -drive "if=pflash,format=raw,file=$vars"
        -drive "if=none,id=disk,file=$disk,format=qcow2,discard=unmap"
        -device virtio-blk-pci,drive=disk,bootindex=1
        -nic user,model=virtio-net-pci
        -device virtio-rng-pci
        -device qemu-xhci -device usb-tablet
        -device virtio-vga -display gtk
    )
    if [[ $1 == install ]]; then
        [[ -f $iso ]] || die "no ISO yet, run: ${0##*/} iso"
        cmd+=(-drive "if=none,id=cd,file=$iso,media=cdrom,readonly=on" -device ide-cd,drive=cd,bootindex=0)
    fi
    exec "${cmd[@]}"
}

case "${1:-}" in
    iso)     get_iso ;;
    install) boot install ;;
    run)     boot run ;;
    reset)
        read -rp "Delete the Oblio VM disk and UEFI variables? [y/N] " a
        [[ $a == [yY] ]] && rm -f "$disk" "$vars" && echo "deleted" ;;
    *)
        sed -n '4,7p' "$0" | sed 's/^# //' >&2
        exit 1 ;;
esac
