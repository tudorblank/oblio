#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Builds Oblio's own packages into a local pacman repo: out/repo
# Runs as your normal user.

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="$root/out"
repo="$out/repo"
build="$out/build"

[[ $EUID != 0 ]] || { echo "error: run as your normal user, not root" >&2; exit 1; }

rm -rf "$repo" "$build"
mkdir -p "$repo" "$build"

export PKGDEST="$repo" BUILDDIR="$build" SRCDEST="$build/sources"
mkdir -p "$SRCDEST"

for p in "$root"/base/packages/*/; do
    echo "==> $(basename "$p")"
    (cd "$p" && makepkg -f --nodeps --noconfirm)
done

repo-add -q "$repo/oblio.db.tar.gz" "$repo"/*.pkg.tar.zst
rm -rf "$build"
echo "==> packages in $repo:"
ls "$repo"/*.pkg.tar.zst | xargs -n1 basename
